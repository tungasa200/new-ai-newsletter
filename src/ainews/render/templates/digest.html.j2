{#- 메일 클라이언트 호환: 표 레이아웃, 인라인 스타일만, 외부 CSS·웹폰트·이미지·스크립트 없음.
    다크모드: 클라이언트가 색을 뒤집어도 대비가 남도록 모든 칸에 배경색을 명시하고, 코드 블록도 밝은 바탕을 쓴다. -#}
{%- set font = "-apple-system,BlinkMacSystemFont,'Apple SD Gothic Neo','Malgun Gothic',Arial,sans-serif" -%}
{%- set mono = "Consolas,Menlo,'Courier New',monospace" -%}
{%- set p = "margin:0 0 14px 0;font-size:16px;line-height:1.7;color:#27272a;" -%}
{%- set list = "margin:0 0 14px 0;padding-left:22px;font-size:16px;line-height:1.7;color:#27272a;" -%}
{%- set li = "margin:0 0 6px 0;" -%}
{%- set h2 = "margin:0;padding-bottom:8px;border-bottom:2px solid #18181b;font-size:19px;line-height:1.4;color:#18181b;" -%}
{%- set badge = "display:inline-block;margin:0 4px 4px 0;padding:2px 8px;border-radius:3px;font-size:12px;line-height:1.5;" -%}
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#f4f4f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f4f4f5;">
<tr><td align="center" style="padding:24px 8px;">
<table role="presentation" width="640" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:640px;font-family:{{ font }};">

<tr><td style="padding:28px 24px 24px 24px;background:#ffffff;border-top:4px solid #18181b;">
  <h1 style="margin:0;font-size:28px;line-height:1.3;font-weight:800;letter-spacing:-0.5px;color:#18181b;">AI Daily</h1>
  <p style="margin:4px 0 20px 0;font-size:14px;line-height:1.5;color:#71717a;">{{ d.date.strftime("%Y.%m.%d") }}{% if d.items %} · 핵심 {{ d.items | length }}건{% endif %}{% if d.releases %} · 릴리스 {{ d.releases | length }}건{% endif %}</p>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td style="padding:14px 16px;background:#f4f4f5;border-left:3px solid #18181b;">
    <p style="margin:0;font-size:16px;line-height:1.7;color:#27272a;">{{ d.summary }}</p>
  </td></tr></table>
</td></tr>

<tr><td style="padding:8px 24px 4px 24px;background:#ffffff;">
  <h2 style="{{ h2 }}">오늘의 핵심</h2>
{% if not d.items %}
  <p style="{{ p }}margin-top:16px;color:#52525b;">{{ empty_items }}</p>
{% endif %}
</td></tr>
{% for e in d.items %}
{% set accent = "#15803d" if e.kind == "tip" else "#4338ca" %}
{% set label = "margin:20px 0 6px 0;font-size:14px;line-height:1.5;font-weight:bold;color:" ~ accent ~ ";" %}
<tr><td style="padding:24px 24px 24px 24px;background:#ffffff;{% if not loop.first %}border-top:1px solid #e4e4e7;{% endif %}">
  <p style="margin:0 0 6px 0;font-size:12px;line-height:1.5;">
    <span style="{{ badge }}background:{% if e.kind == 'tip' %}#dcfce7;color:#166534{% else %}#e0e7ff;color:#3730a3{% endif %};font-weight:bold;">{{ kind_label[e.kind] }}</span>
{% if e.is_update %}
    <span style="{{ badge }}background:#fef3c7;color:#92400e;font-weight:bold;">업데이트</span>
{% endif %}
    <span style="{{ badge }}{% if e.freshness == 'current' %}background:#f4f4f5;color:#52525b;{% else %}background:#fee2e2;color:#991b1b;font-weight:bold;{% endif %}">신선도: {{ freshness_label[e.freshness] }}</span>
  </p>
  <h3 style="margin:4px 0 0 0;font-size:21px;line-height:1.45;font-weight:bold;color:#18181b;"><span style="color:{{ accent }};">{{ "%02d" | format(loop.index) }}</span>&nbsp; <a href="{{ e.sources[0].url }}" style="color:#18181b;text-decoration:none;">{{ e.title }}</a></h3>
  <p style="{{ label }}">배경</p>
  <p style="{{ p }}">{{ e.background }}</p>
  <p style="{{ label }}">핵심 내용</p>
{% for para in e.details %}
  <p style="{{ p }}">{{ para }}</p>
{% endfor %}
  <p style="{{ label }}">실무 적용</p>
  <p style="{{ p }}">{{ e.how_to_apply }}</p>
{% if e.kind == "tip" %}
{% if e.applies_to %}
  <p style="margin:0 0 14px 0;font-size:14px;line-height:1.6;color:#3f3f46;"><strong>적용 대상:</strong> {{ e.applies_to }}</p>
{% endif %}
{% if e.steps %}
  <p style="{{ label }}">바로 해 볼 것</p>
  <ol style="{{ list }}">
{% for s in e.steps %}
    <li style="{{ li }}">{{ s }}</li>
{% endfor %}
  </ol>
{% endif %}
{% for b in e.code_blocks %}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 14px 0;"><tr><td style="padding:12px 14px;background:#f6f8fa;border:1px solid #e4e4e7;border-radius:4px;">
{% if b.lang %}<p style="margin:0 0 6px 0;font-size:11px;line-height:1.4;color:#71717a;font-family:{{ mono }};">{{ b.lang }}</p>{% endif %}
<pre style="margin:0;white-space:pre-wrap;word-wrap:break-word;font-size:13px;line-height:1.55;color:#18181b;font-family:{{ mono }};">{{ b.code }}</pre>
  </td></tr></table>
{% endfor %}
{% endif %}
{% if e.caveats %}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:6px 0 14px 0;"><tr><td style="padding:12px 16px 2px 16px;background:#fffbeb;border-left:3px solid #f59e0b;">
    <p style="margin:0 0 6px 0;font-size:14px;line-height:1.5;font-weight:bold;color:#92400e;">주의점·한계</p>
    <ul style="margin:0 0 10px 0;padding-left:20px;font-size:15px;line-height:1.65;color:#3f3f46;">
{% for c in e.caveats %}
      <li style="{{ li }}">{{ c }}</li>
{% endfor %}
    </ul>
  </td></tr></table>
{% endif %}
  <p style="margin:16px 0 0 0;font-size:13px;line-height:1.6;color:#71717a;">출처:
{% for s in e.sources %}
    <a href="{{ s.url }}" style="color:#2563eb;">{{ s.title }}</a> ({{ source_label[s.kind] }}){% if not loop.last %} · {% endif %}

{% endfor %}
  </p>
</td></tr>
{% endfor %}

{% if d.releases %}
<tr><td style="padding:8px 0 0 0;background:#f4f4f5;"></td></tr>
<tr><td style="padding:28px 24px 20px 24px;background:#ffffff;">
  <h2 style="{{ h2 }}">도구·릴리스 변경</h2>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
{% for r in d.releases %}
    <tr><td style="padding:12px 0;{% if not loop.last %}border-bottom:1px solid #e4e4e7;{% endif %}font-size:15px;line-height:1.6;color:#27272a;">
      <strong style="color:#18181b;">{{ r.tool }}{% if r.version %} {{ r.version }}{% endif %}</strong>: {{ r.one_line }} <a href="{{ r.url }}" style="font-size:13px;color:#2563eb;white-space:nowrap;">변경 내역</a>
    </td></tr>
{% endfor %}
  </table>
</td></tr>
{% endif %}

<tr><td style="padding:20px 24px 8px 24px;background:#f4f4f5;">
  <p style="margin:0;font-size:12px;line-height:1.6;color:#71717a;">Claude가 공식 소스와 커뮤니티 글을 골라 편집한 메일입니다. 사실 확인은 출처 링크를 기준으로 해 주세요.</p>
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
